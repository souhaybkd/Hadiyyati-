# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets. .env.local is git-ignored.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email Configuration
# The FROM domain must be verified in Resend (https://resend.com/domains)
# or sends will fail with 403.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hadiyyati <noreply@hadiyyati.com>
RESEND_REPLY_TO_EMAIL=support@hadiyyati.com
CONTACT_TO_EMAIL=info@hadiyyati.me

# Stripe Configuration
# Optional: these can also be managed from Admin -> Payment Gateways.
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Veriff KYC Configuration
# Server-only. Get keys from Veriff Customer Portal > Integrations.
VERIFF_API_KEY=your_veriff_api_key
VERIFF_SHARED_SECRET_KEY=your_veriff_shared_secret_key
VERIFF_BASE_URL=https://stationapi.veriff.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
